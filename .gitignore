node_modules/
dist/

# Claude Code's worktrees land INSIDE the repo (.claude/worktrees/<name>), so without
# this the first feature worktree shows up as untracked content in the main checkout —
# and a `git add -A` would happily commit a second checkout inside the first.
.claude/worktrees/
# Per-user Claude Code permission overrides — not shared. .claude/settings.json IS tracked.
.claude/settings.local.json

# Per-machine runtime state the app rewrites as you drag sliders and zoom. The
# code carries working defaults (src/main/overlayConfig.js), so a fresh clone
# runs without them. config/calibration.json and config/dd2.offsets.json ARE
# tracked — those are hard-won and costly to reproduce.
config/overlay.json
config/view.json
# Which map source you last picked (auto/online/offline). Per-machine, and the code
# defaults to 'auto' without it.
config/cache.json

# Derived cache: mapgenie's region/portal graph, re-extracted from the live page on
# every launch (src/renderer/mapAgent.js's __dd2_extract_areas). 300KB of churn, and
# worthless without mapgenie reachable anyway — and if it isn't, there's no map to
# put the markers on either. config/dungeons.json (the solved per-dungeon inset
# transforms) and config/areas.json (buildings you've named) are NOT ignored: both
# hold work that cost real playtime to produce.
config/mapgenie-areas.json

# The game's own map, pulled out of DD2's paks: the extractor scripts, the two
# downloaded indexes they need (a 21MB path list, a 42MB RSZ type registry), and
# ~260MB of extracted Capcom assets. All of it is either downloadable or
# regenerable from a DD2 install in one command — and the assets are Capcom's, so
# they must not end up in a commit or in the shipped exe. See .map/README.md.
.map/

# Byproducts of the reverse-engineering scripts in tools/: memory dumps,
# pointer-scan results, watch logs. They run from the repo root and write here.
# Gigabytes of them, and all reproducible — the findings that came out of them
# live in FINDINGS.md and config/dd2.offsets.json.
*.bin
*.csv
app_log*.txt
watch*.txt
zone_log.txt
chains*.json
ct_*
z_*
cand*.txt
camera2.candidates.json
ce_out.txt
focused_*
global_watch.txt
logger_status.txt
snapshot_*.txt
check_*.txt
