node_modules/

# Per-machine runtime state the app rewrites as you drag sliders and zoom. The
# code carries working defaults (src/main/overlayConfig.js), so a fresh clone
# runs without them. config/calibration.json and config/dd2.offsets.json ARE
# tracked — those are hard-won and costly to reproduce.
config/overlay.json
config/view.json

# Byproducts of the reverse-engineering scripts in tools/: memory dumps,
# pointer-scan results, watch logs. They run from the repo root and write here.
# Gigabytes of them, and all reproducible — the findings that came out of them
# live in FINDINGS.md and config/dd2.offsets.json.
*.bin
*.csv
app_log*.txt
watch*.txt
chains*.json
ct_*
z_*
cand*.txt
ce_out.txt
focused_*
global_watch.txt
logger_status.txt
snapshot_*.txt
check_*.txt
